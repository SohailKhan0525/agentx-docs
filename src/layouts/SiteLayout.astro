---
interface Props { title: string; description?: string; docs?: boolean }
const { title, description = 'AgentX is a terminal based AI agent for real software projects.', docs = false } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="generator" content="Astro" /><meta name="description" content={description} /><meta name="theme-color" content="#f4f3ee" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><link rel="icon" href="/img/agentx-mark.svg" /><title>{title}</title></head><body class={docs?'docs-page':''}>
<header class="site-nav"><div class="nav-inner"><a class="brand" href="/" aria-label="AgentX home"><img src="/img/agentx-mark.svg" alt="" />AgentX</a><nav aria-label="Primary"><a href="/docs/intro/">Docs</a><a href="/docs/installation/">Install</a><a href="/docs/providers/">Models</a><a href="https://github.com/SohailKhan0525/agentxcode">GitHub</a></nav></div></header>
<slot />
<footer class="site-footer"><div class="footer-inner"><div><strong>AgentX</strong><p>A terminal agent for real software projects.</p></div><div class="footer-links"><a href="/docs/intro/">Docs</a><a href="/docs/security/">Security</a><a href="/docs/privacy/">Privacy</a><a href="/docs/terms/">Terms</a><a href="https://github.com/SohailKhan0525/agentx-docs">Source</a></div></div></footer>
</body></html>
<style>
@font-face{font-family:Geist;src:local('Geist');font-display:swap}@font-face{font-family:'Geist Mono';src:local('Geist Mono');font-display:swap}
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fff;color:#171716;font-family:Geist,system-ui,sans-serif}:global(a){color:inherit}:global(:focus-visible){outline:2px solid #111;outline-offset:3px}.site-nav{height:64px;background:rgba(255,255,255,.96);border-bottom:1px solid #deddd6;backdrop-filter:blur(14px)}.nav-inner{width:min(1160px,calc(100% - 48px));height:100%;margin:auto;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:650}.brand img{width:28px;height:28px}.site-nav nav{display:flex;gap:28px}.site-nav nav a{font-size:14px;text-decoration:none;color:#666}.site-nav nav a:hover{color:#111}.site-footer{background:#111;color:#aaa;border-top:1px solid #222}.footer-inner{width:min(1160px,calc(100% - 48px));margin:auto;padding:64px 0;display:flex;justify-content:space-between;gap:48px}.site-footer strong{color:#fff}.site-footer p{margin:8px 0 0;font-size:14px}.footer-links{display:flex;gap:20px;flex-wrap:wrap}.footer-links a{text-decoration:none;font-size:14px}.footer-links a:hover{color:#fff}@media(max-width:640px){.nav-inner,.footer-inner{width:calc(100% - 32px)}.site-nav nav{gap:14px}.site-nav nav a:nth-child(2),.site-nav nav a:nth-child(3){display:none}.footer-inner{flex-direction:column}}
@media(max-width:640px){.site-nav{height:auto}.nav-inner{min-height:60px}.site-nav nav{gap:12px;overflow-x:auto;max-width:70vw;padding:10px 0}.site-nav nav a{font-size:13px;white-space:nowrap}.footer-inner{padding:48px 0}}\n</style>